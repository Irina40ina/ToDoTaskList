    "gsap": "^3.12.5",
    "pinia": "^2.2.4",
    "vue": "^3.4.37",
    "vuetify": "^3.7.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^5.4.1",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.0.29"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
